@import "../../app.wxss";

.detail-page {
  padding: 28rpx 32rpx 0;
}

.article-head {
  padding: 10rpx 2rpx 30rpx;
}

.category {
  display: inline-block;
  color: #004098;
  background: #E9F2FA;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.subtitle {
  display: block;
  margin-top: 24rpx;
  color: #004098;
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.title {
  display: block;
  margin-top: 20rpx;
  font-size: 45rpx;
  line-height: 1.36;
  font-weight: 700;
  color: #152332;
}

.meta {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  color: #84919E;
  font-size: 22rpx;
  line-height: 1.5;
}

.cover {
  width: 686rpx;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 64, 152, 0.08);
}

.lead {
  margin: 34rpx 0 6rpx;
  padding: 25rpx 27rpx;
  border-left: 7rpx solid #00A0E9;
  background: #EEF6FC;
  border-radius: 0 16rpx 16rpx 0;
  color: #385064;
  font-size: 28rpx;
  line-height: 1.75;
}

.article-body {
  padding-top: 14rpx;
}

.paragraph {
  display: block;
  margin: 28rpx 0;
  color: #273440;
  font-size: 31rpx;
  line-height: 1.9;
  text-align: justify;
}

.source-card {
  margin-top: 48rpx;
  padding: 24rpx;
  border-top: 1rpx solid #DDE5EC;
  border-bottom: 1rpx solid #DDE5EC;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.source-label,
.source-name {
  display: block;
}

.source-label {
  color: #94A0AB;
  font-size: 20rpx;
}

.source-name {
  margin-top: 6rpx;
  color: #344A5E;
  font-size: 25rpx;
  font-weight: 600;
}

.source-action {
  margin: 0;
  padding: 0 20rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 16rpx;
  background: #F1F6FB;
  color: #004098;
  font-size: 22rpx;
}

.article-end {
  padding: 38rpx 0 10rpx;
  display: flex;
  justify-content: center;
}

.article-actions {
  min-width: 360rpx;
  padding: 10rpx 8rpx;
  border-radius: 22rpx;
  background: #F1F5F8;
  display: flex;
  align-items: stretch;
}

.article-action {
  width: 170rpx;
  min-height: 104rpx;
  margin: 0;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: transparent;
  color: #758696;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1.2;
  transition: transform 170ms ease, color 170ms ease, background-color 170ms ease;
}

.article-favorite--active {
  color: #004098;
}

.article-action-hover {
  transform: scale(0.95);
  background: #E6EEF5;
}

.article-action-divider {
  width: 1rpx;
  margin: 18rpx 2rpx;
  background: #D8E2EA;
}

.article-star {
  font-size: 49rpx;
  line-height: 1;
}

.article-share-icon {
  font-size: 43rpx;
  line-height: 1;
  font-weight: 500;
}

.article-action-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.article-share {
  color: #5E7386;
}

.article-note {
  padding: 28rpx 8rpx 10rpx;
  text-align: center;
  color: #9AA4AE;
  font-size: 19rpx;
  line-height: 1.6;
}

.meta text + text { margin-top: 8rpx; }

/* OUC_NEWS_SYNC START */
.cover-caption,
.image-caption {
  display: block;
  margin-top: 12rpx;
  padding: 0 18rpx;
  text-align: center;
  color: #8A96A2;
  font-size: 22rpx;
  line-height: 1.55;
}

.article-body {
  padding-top: 18rpx;
}

.body-heading {
  display: block;
  margin: 38rpx 0 18rpx;
  color: #172431;
  font-size: 34rpx;
  line-height: 1.5;
  font-weight: 700;
}

.body-image-block {
  margin: 34rpx 0;
}

.body-image {
  width: 686rpx;
  border-radius: 18rpx;
  background: #E8EEF3;
}

.credit {
  display: block;
  margin: 12rpx 0;
  color: #7D8A96;
  font-size: 24rpx;
  line-height: 1.65;
}
/* OUC_NEWS_SYNC END */
