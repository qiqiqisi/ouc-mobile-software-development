<view class="detail-page" wx:if="{{article}}">
  <view class="article-head">
    <text class="category">{{article.category}}</text>
    <text class="title">{{article.title}}</text>

    <view class="meta">
      <text>{{article.date}}</text>
      <text>
        {{article.author}}
        <text wx:if="{{article.author && article.source}}"> · </text>
        {{article.source}}
      </text>
    </view>
  </view>

  <image
    wx:if="{{article.cover}}"
    class="cover"
    src="{{article.cover}}"
    mode="widthFix"
  />

  <text
    wx:if="{{article.coverCaption}}"
    class="cover-caption"
  >{{article.coverCaption}}</text>

  <view class="article-body">
    <block wx:for="{{article.content}}" wx:key="index">
      <text
        wx:if="{{item.type === 'paragraph'}}"
        class="paragraph"
      >{{item.text}}</text>

      <text
        wx:elif="{{item.type === 'heading'}}"
        class="body-heading"
      >{{item.text}}</text>

      <view
        wx:elif="{{item.type === 'image'}}"
        class="body-image-block"
      >
        <image
          class="body-image"
          src="{{item.src}}"
          mode="widthFix"
        />
        <text
          wx:if="{{item.caption}}"
          class="image-caption"
        >{{item.caption}}</text>
      </view>

      <text
        wx:elif="{{item.type === 'credit'}}"
        class="credit"
      >{{item.text}}</text>
    </block>
  </view>

  <view class="source-card">
    <view>
      <text class="source-label">来源</text>
      <text class="source-name">{{article.origin}}</text>
    </view>

    <button
      class="source-action pressable"
      hover-class="pressable-hover"
      bindtap="copySource"
    >复制原文地址</button>
  </view>

  <view class="article-end">
    <view class="article-actions">
      <view
        class="article-action article-favorite {{isFavorite ? 'article-favorite--active' : ''}}"
        hover-class="article-action-hover"
        hover-stay-time="70"
        bindtap="toggleFavorite"
      >
        <text class="article-star">{{isFavorite ? '★' : '☆'}}</text>
        <text class="article-action-text">{{isFavorite ? '已收藏' : '收藏本文'}}</text>
      </view>

      <view class="article-action-divider"></view>

      <button
        class="article-action article-share"
        open-type="share"
        hover-class="article-action-hover"
        hover-stay-time="70"
      >
        <text class="article-share-icon">↗</text>
        <text class="article-action-text">分享新闻</text>
      </button>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
