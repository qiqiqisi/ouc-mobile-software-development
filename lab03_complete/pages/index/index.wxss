@import "../../app.wxss";

.page {
  padding: 0 32rpx;
}

.brand {
  padding: 28rpx 0 22rpx;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 74rpx;
  height: 74rpx;
  margin-right: 20rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.brand-wordmark {
  width: 276rpx;
}

.brand-en {
  margin-top: 5rpx;
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #75879A;
}

.hero-copy {
  margin-top: 42rpx;
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 50rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  margin-top: 9rpx;
  color: #7D8C9A;
  font-size: 21rpx;
  letter-spacing: 4rpx;
}

.headline-swiper {
  height: 392rpx;
  overflow: visible;
}

.headline-card {
  height: 374rpx;
  border-radius: 26rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 12rpx 36rpx rgba(0, 64, 152, 0.12);
}

.headline-image {
  width: 100%;
  height: 100%;
}

.headline-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(10, 28, 46, 0.02) 30%,
    rgba(6, 28, 52, 0.82) 100%
  );
}

.headline-content {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 26rpx;
  color: #FFFFFF;
}

.headline-category {
  display: inline-block;
  font-size: 21rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.17);
}

.headline-title {
  display: block;
  margin-top: 17rpx;
  font-size: 37rpx;
  line-height: 1.35;
  font-weight: 700;
}

.headline-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 17rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 1rpx;
}

.section-head {
  margin-top: 46rpx;
  display: flex;
  align-items: flex-end;
}

.section-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
}

.section-en {
  display: block;
  margin-top: 3rpx;
  color: #8A98A7;
  font-size: 19rpx;
  letter-spacing: 4rpx;
}

.section-line {
  height: 1rpx;
  background: #DDE5EC;
  flex: 1;
  margin: 0 0 10rpx 24rpx;
}

/* 搜索：浅色、低对比度，不抢头图。 */
.search-box {
  height: 76rpx;
  margin-top: 28rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #EDF3F8;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.search-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.search-circle {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 19rpx;
  height: 19rpx;
  border: 3rpx solid #71869A;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-handle {
  position: absolute;
  left: 21rpx;
  top: 21rpx;
  width: 11rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #71869A;
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #243544;
  font-size: 26rpx;
}

.search-placeholder {
  color: #8B9AA8;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: rgba(72, 95, 116, 0.10);
  color: #6C7E8E;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
  transition: transform 120ms ease, background-color 120ms ease;
}

.search-clear-hover {
  transform: scale(0.92);
  background: rgba(72, 95, 116, 0.17);
}

/* 分类：文字 Tab + 短下划线，避免胶囊按钮过多。 */
.category-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  align-items: flex-end;
}

.category-item {
  position: relative;
  margin-right: 38rpx;
  padding: 13rpx 0 16rpx;
  color: #7F8E9D;
  font-size: 25rpx;
  font-weight: 500;
  transition: color 150ms ease;
}

.category-item--active {
  color: #004098;
  font-weight: 650;
}

.category-indicator {
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: #004098;
  transform: translateX(-50%);
  transition: width 160ms ease;
}

.category-item--active .category-indicator {
  width: 34rpx;
}

.news-list {
  margin-top: 8rpx;
}

.news-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #E3EAF0;
  transition: transform 140ms ease, background-color 140ms ease;
  border-radius: 14rpx;
}

.news-main {
  flex: 1;
  min-width: 0;
  padding-right: 22rpx;
}

.news-meta {
  display: flex;
  align-items: center;
  color: #8291A0;
  font-size: 21rpx;
}

.news-category {
  color: #004098;
  font-weight: 600;
}

.dot {
  margin: 0 9rpx;
}

.news-title {
  display: -webkit-box;
  margin-top: 11rpx;
  font-size: 31rpx;
  line-height: 1.42;
  font-weight: 650;
  color: #182431;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.news-lead {
  display: -webkit-box;
  margin-top: 10rpx;
  color: #738292;
  font-size: 22rpx;
  line-height: 1.5;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.news-visual {
  position: relative;
  width: 208rpx;
  height: 144rpx;
  flex-shrink: 0;
}

.news-thumb,
.news-no-photo {
  width: 208rpx;
  height: 144rpx;
  border-radius: 16rpx;
}

.news-thumb {
  background: #E7EDF3;
}

.news-no-photo {
  box-sizing: border-box;
  padding: 22rpx;
  background: #EAF3FB;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.no-photo-ou,
.no-photo-label {
  display: block;
}

.no-photo-ou {
  color: #004098;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.no-photo-label {
  margin-top: 8rpx;
  color: #5D7891;
  font-size: 18rpx;
  letter-spacing: 4rpx;
}

/* 星标覆盖在图片右上，不占用标题区域。 */
.favorite-star {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 5rpx 16rpx rgba(18, 43, 65, 0.13);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #687C8E;
  font-size: 34rpx;
  line-height: 1;
  transition: transform 170ms ease, color 170ms ease, background-color 170ms ease;
}

.favorite-star--active {
  color: #004098;
  background: rgba(255, 255, 255, 0.98);
}

.favorite-star-hover {
  transform: scale(0.88);
}

/* 搜索无结果状态 */
.search-empty {
  padding: 94rpx 0 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-mark {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  opacity: 0.75;
}

.empty-mark-circle {
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  width: 38rpx;
  height: 38rpx;
  border: 5rpx solid #7890A4;
  border-radius: 50%;
  box-sizing: border-box;
}

.empty-mark-handle {
  position: absolute;
  left: 42rpx;
  top: 43rpx;
  width: 23rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: #7890A4;
  transform: rotate(45deg);
  transform-origin: left center;
}

.empty-title {
  margin-top: 24rpx;
  color: #2B3B49;
  font-size: 28rpx;
  font-weight: 650;
}

.empty-desc {
  margin-top: 10rpx;
  color: #8B98A5;
  font-size: 22rpx;
}
