<view class="edit-page"><view class="avatar-section"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{saving}}"><image class="edit-avatar" src="{{avatarDisplay}}" mode="aspectFill" /><view class="avatar-edit-mark"><ouc-icon name="edit" size="27" /></view></button><text class="avatar-tip">点击更换头像</text></view><view class="edit-row"><text class="field-label">昵称</text><input class="nickname-input" type="nickname" maxlength="20" value="{{nickname}}" disabled="{{saving}}" placeholder="输入你想显示的昵称" placeholder-class="input-placeholder" bindinput="onNicknameInput" /></view><view class="edit-row"><text class="field-label">学校</text><text class="school-name">中国海洋大学</text></view><text class="edit-hint">昵称最多 20 字。头像和昵称仅由你主动设置。</text><button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">{{saving ? '正在保存…' : '保存资料'}}</button></view>
