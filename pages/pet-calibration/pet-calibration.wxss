.page { padding: 32rpx; } .title { display:block; font-size:38rpx; font-weight:700; } .tip,.output { display:block; margin-top:16rpx; font-size:22rpx; line-height:1.6; color:#68756d; white-space:pre-wrap; } .grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:24rpx; } .card { padding:12rpx; border-radius:16rpx; background:#f4f7f4; font-size:22rpx; } .card image { display:block; width:100%; height:230rpx; } .controls { margin-top:24rpx; padding:20rpx; border-radius:18rpx; background:#f7faf7; font-size:23rpx; }
