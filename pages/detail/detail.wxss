page { background: #fff; }
.detail-page { min-height: 100vh; padding-bottom: calc(124rpx + env(safe-area-inset-bottom)); background: #fff; }
.author-bar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; height: 110rpx; padding: 12rpx 22rpx 12rpx 30rpx; background: #fff; }
.author { display: flex; flex: 1; min-width: 0; align-items: center; margin-right: 20rpx; }
.author-avatar { width: 68rpx; height: 68rpx; border-radius: 50%; flex-shrink: 0; background: #f5f7f9; }
.author-name { margin-left: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; }
.icon-button { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; min-width: 0; padding: 0; margin: 0 0 0 10rpx; background: transparent; line-height: 1; border-radius: 50%; flex-shrink: 0; }
.more-button { width: 52rpx; margin-left: 0; }
.gallery { position: relative; background: #f5f7f9; }
.image-swiper { height: 820rpx; width: 100%; }
.detail-image { display: block; width: 100%; height: 100%; }
.image-counter { position: absolute; top: 22rpx; right: 25rpx; padding: 8rpx 18rpx; border-radius: 28rpx; background: rgba(0,0,0,.36); color: #fff; font-size: 22rpx; }
.gallery-dots { display: flex; justify-content: center; padding: 20rpx 0 0; background: #fff; }
.gallery-dot { width: 9rpx; height: 9rpx; margin: 0 6rpx; border-radius: 50%; background: #dce1e5; }
.gallery-dot.selected { background: #1980c8; }
.note-body { padding: 30rpx 32rpx 28rpx; }
.note-title { display: block; font-size: 36rpx; line-height: 1.5; font-weight: 600; word-break: break-all; }
.note-content { display: block; margin-top: 16rpx; font-size: 30rpx; line-height: 1.85; white-space: pre-wrap; word-break: break-all; }
.note-topic { display: block; margin: 22rpx 0; font-size: 28rpx; color: #176594; }
.location-pill { display: inline-flex; align-items: center; max-width: 100%; padding: 8rpx 14rpx; background: #f5f6f7; border-radius: 24rpx; font-size: 23rpx; color: #68717a; }
.location-pill text { margin-left: 5rpx; word-break: break-all; }
.contact-text { display: block; margin-top: 20rpx; font-size: 26rpx; color: #616973; word-break: break-all; }
.note-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; font-size: 23rpx; color: #969da4; }
.status-pill { color: #1980c8; background: #edf7fd; border-radius: 20rpx; padding: 6rpx 14rpx; }
.status-pill.resolved { color: #328465; background: #edf8f3; }
.comments-section { border-top: 1rpx solid #f0f1f3; margin: 0 32rpx; padding-top: 26rpx; }
.comments-heading { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; color: #3b4148; }
.comment-order { font-size: 23rpx; color: #969da4; }
.comment-prompt { display: flex; align-items: center; margin: 28rpx 0 10rpx; }
.comment-avatar { width: 68rpx; height: 68rpx; border-radius: 50%; flex-shrink: 0; background: #f5f7f9; }
.prompt-input { display: flex; align-items: center; justify-content: space-between; flex: 1; margin-left: 20rpx; padding: 18rpx 24rpx; color: #a0a5ac; background: #f5f5f5; font-size: 27rpx; border-radius: 42rpx; }
.comment-row { display: flex; padding: 30rpx 0 22rpx; }
.comment-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.comment-byline { display: flex; align-items: center; }
.comment-name { color: #90969d; font-size: 25rpx; max-width: 80%; word-break: break-all; }
.author-badge { margin-left: 12rpx; padding: 2rpx 8rpx; color: #1980c8; background: #edf7fd; border-radius: 6rpx; font-size: 19rpx; }
.comment-content { display: block; margin-top: 10rpx; color: #30343b; font-size: 29rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.reply-to { display: block; margin-top: 10rpx; font-size: 24rpx; color: #176594; }
.comment-meta { display: flex; align-items: center; color: #9ca2a9; font-size: 23rpx; padding-top: 6rpx; }
.reply-action, .delete-comment { padding: 14rpx 18rpx; color: #68717a; }
.delete-comment { margin-left: auto; font-size: 22rpx; }
.comment-empty { padding: 60rpx 10rpx; color: #969da4; font-size: 26rpx; text-align: center; }
.comment-end { padding: 35rpx; text-align: center; font-size: 22rpx; color: #b0b5bb; }
.bottom-bar { position: fixed; z-index: 50; bottom: 0; left: 0; right: 0; display: flex; align-items: center; padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #f0f1f3; }
.bottom-input { display: flex; align-items: center; flex: 1; min-width: 0; height: 72rpx; padding: 0 20rpx; border-radius: 40rpx; background: #f5f5f5; color: #989da3; font-size: 25rpx; }
.bottom-input text { margin-left: 10rpx; white-space: nowrap; }
.reaction { display: flex; align-items: center; justify-content: center; padding: 0 10rpx; margin: 0 0 0 7rpx; height: 78rpx; min-width: 108rpx; max-width: 150rpx; border-radius: 0; background: transparent; line-height: 1; font-size: 25rpx; }
.reaction text { margin-left: 9rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.reaction.active { color: #1980c8; }
.composer-mask { position: fixed; z-index: 100; top: 0; bottom: 0; left: 0; right: 0; background: rgba(15,27,41,.35); }
.composer { position: absolute; left: 0; right: 0; padding: 12rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; }
.composer-heading { display: flex; align-items: center; justify-content: space-between; font-size: 27rpx; color: #626a74; }
.composer-textarea { width: 100%; height: 210rpx; padding: 22rpx; border-radius: 18rpx; background: #f5f7f9; font-size: 29rpx; line-height: 1.6; }
.composer-footer { display: flex; align-items: center; margin-top: 20rpx; color: #939ba3; font-size: 23rpx; }
.cancel-reply { padding: 12rpx 20rpx; color: #1980c8; }
.send-button { margin: 0 0 0 auto; width: 144rpx; height: 66rpx; padding: 0; line-height: 66rpx; border-radius: 36rpx; background: #1980c8; color: #fff; font-size: 27rpx; }
.detail-skeleton { padding: 24rpx; }
.skeleton-author, .skeleton-image, .skeleton-line { border-radius: 12rpx; background: #f2f4f6; margin-bottom: 28rpx; }
.skeleton-author { height: 70rpx; width: 45%; }
.skeleton-image { height: 760rpx; }
.skeleton-line { height: 40rpx; width: 75%; }
