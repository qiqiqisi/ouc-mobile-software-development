.game-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 72rpx;
  background: #F5F1E8;
}

.game-heading {
  display: flex;
  flex-direction: column;
}

.game-index {
  color: #91A82E;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.game-title {
  margin-top: 9rpx;
  color: #252821;
  font-size: 40rpx;
  font-weight: 750;
  line-height: 1.2;
}

.game-subtitle {
  margin-top: 9rpx;
  color: #888378;
  font-size: 23rpx;
  line-height: 1.5;
}

.stats-card {
  display: flex;
  align-items: stretch;
  height: 112rpx;
  margin-top: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #E5DED1;
  border-radius: 26rpx;
  background: #FFFDF9;
  box-shadow: 0 10rpx 28rpx rgba(77, 65, 47, 0.06);
}

.stat-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-label {
  color: #A19A8E;
  font-size: 20rpx;
}

.stat-value {
  margin-top: 6rpx;
  color: #252821;
  font-size: 32rpx;
  font-weight: 750;
}

.stat-divider {
  width: 1rpx;
  margin: 24rpx 0;
  background: #E9E2D6;
}

.board-shell {
  position: relative;
  margin-top: 24rpx;
  height: 686rpx;
  padding: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid #DED6C8;
  border-radius: 30rpx;
  background: #E8E1D5;
  box-shadow: 0 14rpx 34rpx rgba(77, 65, 47, 0.08);
}

.game-canvas {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  display: block;
  width: 650rpx;
  height: 650rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #D9D2C6;
  transition: opacity 80ms ease;
}

.game-canvas-hidden {
  opacity: 0;
  pointer-events: none;
}

.game-canvas-visible {
  opacity: 1;
}

.board-loading {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 650rpx;
  height: 650rpx;
  border-radius: 20rpx;
  background: #F2EEE4;
  color: #746F64;
  font-size: 23rpx;
}

.loading-eyes {
  display: flex;
  margin-bottom: 18rpx;
}

.loading-eye {
  width: 22rpx;
  height: 22rpx;
  margin: 0 7rpx;
  border-radius: 50%;
  background: #B5CF42;
  box-shadow: inset 0 0 0 7rpx #252821;
}

.gesture-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  color: #989084;
  font-size: 20rpx;
}

.control-card {
  margin-top: 22rpx;
  padding: 24rpx 24rpx 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #DDD5C7;
  border-radius: 30rpx;
  background: #EAE4D9;
}

.control-copy {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.control-title {
  color: #33362F;
  font-size: 24rpx;
  font-weight: 750;
}

.control-desc {
  margin-left: 14rpx;
  color: #999184;
  font-size: 19rpx;
}

.dpad {
  position: relative;
  width: 290rpx;
  height: 246rpx;
  margin: 16rpx auto 0;
}

.dpad-key,
.dpad-center {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 70rpx;
  box-sizing: border-box;
  border-radius: 23rpx;
}

.dpad-key {
  border: 1rpx solid #D7CEBF;
  background: #FFFDF9;
  color: #34372F;
  font-size: 31rpx;
  font-weight: 700;
  box-shadow: 0 9rpx 0 #D8CFBF, 0 13rpx 24rpx rgba(70, 59, 43, 0.08);
}

.dpad-key-active {
  background: #C7DC67;
  color: #22261D;
  box-shadow: 0 4rpx 0 #A6BA48;
  transform: translateY(5rpx);
}

.dpad-up {
  left: 106rpx;
  top: 0;
}

.dpad-left {
  left: 18rpx;
  top: 84rpx;
}

.dpad-center {
  left: 106rpx;
  top: 84rpx;
  background: #282C25;
  box-shadow: 0 8rpx 18rpx rgba(49, 44, 34, 0.12);
}

.dpad-right {
  left: 194rpx;
  top: 84rpx;
}

.dpad-down {
  left: 106rpx;
  top: 168rpx;
}

.paw {
  position: relative;
  width: 45rpx;
  height: 40rpx;
}

.paw-toe {
  position: absolute;
  width: 11rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #C7DC67;
}

.paw-toe-1 {
  left: 2rpx;
  top: 7rpx;
  transform: rotate(-22deg);
}

.paw-toe-2 {
  left: 17rpx;
  top: 0;
}

.paw-toe-3 {
  right: 2rpx;
  top: 7rpx;
  transform: rotate(22deg);
}

.paw-pad {
  position: absolute;
  left: 10rpx;
  bottom: 0;
  width: 27rpx;
  height: 22rpx;
  border-radius: 55% 55% 48% 48%;
  background: #C7DC67;
}

.game-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 330rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 76rpx;
}

.action-secondary {
  border: 1rpx solid #242820;
  background: #282C25;
  color: #F7F4EC;
  box-shadow: 0 7rpx 16rpx rgba(55, 48, 37, 0.10);
}

.action-ghost {
  border: 1rpx solid #E1C7C4;
  background: #FFFDF9;
  color: #B46C67;
}

.action-hover {
  transform: scale(0.98);
  opacity: 0.88;
}

.mini-toast {
  position: fixed;
  left: 50%;
  bottom: 46rpx;
  z-index: 90;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(39, 43, 36, 0.95);
  color: #F8F5EE;
  font-size: 21rpx;
  transform: translateX(-50%);
  box-shadow: 0 12rpx 36rpx rgba(56, 47, 34, 0.16);
}

.complete-mask {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100vw;
  height: 100vh;
  box-sizing: border-box;
  padding: 42rpx;
  background: rgba(37, 39, 33, 0.58);
}

.complete-card {
  position: relative;
  width: 620rpx;
  margin-top: 72rpx;
  padding: 96rpx 36rpx 34rpx;
  box-sizing: border-box;
  border: 1rpx solid #DED5C7;
  border-radius: 34rpx;
  background: #FFFDF8;
  color: #252821;
  box-shadow: 0 30rpx 80rpx rgba(48, 41, 31, 0.20);
}

.complete-cat {
  position: absolute;
  left: 50%;
  top: -92rpx;
  width: 240rpx;
  height: 170rpx;
  transform: translateX(-50%);
}

.complete-kicker {
  display: block;
  text-align: center;
  color: #83982B;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.complete-title {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
  text-align: center;
  color: #272A23;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.25;
}

.complete-title-line {
  display: block;
}

.complete-stats {
  display: flex;
  margin-top: 28rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #ECE5D9;
  border-bottom: 1rpx solid #ECE5D9;
}

.complete-stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.complete-label {
  color: #999185;
  font-size: 19rpx;
}

.complete-value {
  margin-top: 7rpx;
  color: #2C2E28;
  font-size: 31rpx;
  font-weight: 750;
}

.complete-optimal {
  color: #80932C;
}

.complete-comment {
  display: block;
  min-height: 70rpx;
  margin-top: 24rpx;
  text-align: center;
  color: #686258;
  font-size: 23rpx;
  line-height: 1.5;
}

.complete-main-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 22rpx;
  background: #C7DC67;
  color: #252A1E;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 78rpx;
}

.complete-main-hover {
  background: #AFC54D;
  transform: scale(0.985);
}

.complete-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.complete-link {
  color: #8C857A;
  font-size: 20rpx;
}

.complete-link-accent {
  color: #718127;
  font-weight: 650;
}
