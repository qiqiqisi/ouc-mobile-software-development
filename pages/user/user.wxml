<view class="page user-page">
  <view wx:if="{{user}}" class="user-header"><view class="user-identity"><image class="user-avatar" src="{{user.avatarFileID || '/assets/ouc-logo.png'}}" mode="aspectFill" /><view class="user-copy"><text class="user-name">{{user.nickname}}</text><text class="user-desc">中国海洋大学 · 校园生活记录者</text></view></view><view class="user-bottom"><view class="user-stats"><view><text class="number">{{user.postCount}}</text><text class="label">笔记</text></view><view><text class="number">{{user.followerCount}}</text><text class="label">粉丝</text></view><view><text class="number">{{user.receivedLikes + user.receivedFavorites}}</text><text class="label">获赞与收藏</text></view></view><button wx:if="{{!user.isSelf}}" class="follow-button {{user.following ? 'followed' : ''}}" bindtap="onFollow">{{user.following ? '已关注' : '+ 关注'}}</button><button wx:else class="follow-button" bindtap="onEdit">编辑资料</button></view></view>
  <view wx:if="{{profileError}}" class="empty-state"><text class="empty-desc">{{profileError}}</text><button class="retry-button" bindtap="load">重新加载</button></view>
  <view class="section-tabs"><view class="section-tab active">公开笔记</view></view>
  <view wx:if="{{initialLoading}}" class="load-more">正在加载…</view>
  <view wx:elif="{{errorText && !posts.length}}" class="empty-state"><text class="empty-desc">{{errorText}}</text><button class="retry-button" bindtap="onRetry">重新加载</button></view>
  <view wx:elif="{{!posts.length}}" class="empty-state"><image class="empty-logo" src="/assets/ouc-logo.png" mode="aspectFit" /><text class="empty-title">还没有公开笔记</text><text class="empty-desc">日常的美好，正在路上。</text></view>
  <view wx:else class="feed"><view class="column"><post-card wx:for="{{posts}}" wx:key="_id" wx:if="{{index % 2 === 0}}" post="{{item}}" show-author="{{false}}" bind:tapcard="onPostTap" bind:tapauthor="onAuthorTap" bind:like="onLikeTap" /></view><view class="column"><post-card wx:for="{{posts}}" wx:key="_id" wx:if="{{index % 2 === 1}}" post="{{item}}" show-author="{{false}}" bind:tapcard="onPostTap" bind:tapauthor="onAuthorTap" bind:like="onLikeTap" /></view></view>
  <view wx:if="{{errorText && posts.length}}" class="load-more" bindtap="onRetry">{{errorText}} · 点击重试</view><view wx:elif="{{loading && !initialLoading}}" class="load-more">正在加载…</view><view wx:elif="{{!hasMore && posts.length}}" class="load-more">— 已经到底了 —</view>
</view>
