.user-page { padding-bottom: 40rpx; }
.user-header { padding: 36rpx; background: linear-gradient(160deg,#edf6fc,#fff); }
.user-identity { display: flex; align-items: center; }
.user-avatar { width: 140rpx; height: 140rpx; border-radius: 50%; border: 5rpx solid #fff; flex-shrink: 0; background: #fff; }
.user-copy { margin-left: 28rpx; min-width: 0; }
.user-name { display: block; font-size: 38rpx; font-weight: 600; word-break: break-all; }
.user-desc { display: block; margin-top: 14rpx; font-size: 23rpx; color: #8b98a3; line-height: 1.6; }
.user-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 35rpx; }
.user-stats { display: flex; }
.user-stats > view { text-align: center; margin-right: 40rpx; }
.number { display: block; font-size: 30rpx; font-weight: 600; }
.label { display: block; margin-top: 9rpx; font-size: 22rpx; color: #8a949e; }
