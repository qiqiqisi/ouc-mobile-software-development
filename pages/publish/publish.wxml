<view class="publish-page">
  <view class="image-section"><view class="image-grid">
    <view wx:for="{{images}}" wx:key="path" class="image-item {{coverIndex === index ? 'cover-selected' : ''}}"><image class="selected-image" src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="onPreviewImage" /><view class="remove-image" data-index="{{index}}" catchtap="onRemoveImage">×</view><view class="cover-action" data-index="{{index}}" catchtap="onSetCover">{{coverIndex === index ? '封面' : '设为封面'}}</view></view>
    <view wx:if="{{images.length < 3}}" class="add-image" bindtap="onChooseImages"><ouc-icon name="plus" active size="47" /><text>添加图片</text><text class="add-count">{{images.length}} / 3</text></view>
  </view><text class="image-tip">{{category === 'scenery' ? '风景笔记至少添加一张图片，多图请选择封面' : '图片可选，多图请选择一张作为封面'}}</text></view>
  <view class="content-section"><view class="title-field"><input class="title-input" maxlength="30" value="{{title}}" disabled="{{publishing}}" placeholder="填写标题，让更多人看见" placeholder-class="placeholder" bindinput="onTitleInput" /><text class="title-counter">{{titleLength}}/30</text></view><textarea class="content-input" maxlength="500" value="{{content}}" disabled="{{publishing}}" auto-height placeholder="记录这一刻的校园日常，分享你的感受…" placeholder-class="placeholder" bindinput="onContentInput" /><text class="content-counter">{{contentLength}} / 500</text></view>
  <view class="publish-section"><view class="section-heading"><text>选择话题</text><text class="section-hint">让同学更容易找到你</text></view><view class="category-list"><view wx:for="{{categories}}" wx:key="key" class="category-item {{category === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onCategoryTap"># {{item.label}}</view></view></view>
  <view class="info-fields"><view class="info-row"><ouc-icon name="location" size="35" /><text class="info-label">添加地点</text><input class="normal-input" maxlength="30" value="{{location}}" disabled="{{publishing}}" placeholder="你在哪里？（选填）" placeholder-class="placeholder" bindinput="onLocationInput" /></view><view wx:if="{{category === 'errand' || category === 'lost'}}" class="info-row"><ouc-icon name="comment" size="35" /><text class="info-label">联系方式</text><input class="normal-input" maxlength="50" value="{{contact}}" disabled="{{publishing}}" placeholder="选填，注意保护隐私" placeholder-class="placeholder" bindinput="onContactInput" /></view></view>
  <view class="publish-note"><image src="/assets/ouc-logo.png" mode="aspectFit" /><text>分享真实日常，传递海大温度</text></view>
  <view class="publish-footer"><button class="main-publish-button" loading="{{publishing}}" disabled="{{publishing}}" bindtap="onPublish">{{publishing ? '正在发布…' : '发布笔记'}}</button></view>
</view>
