page {
  background: #ffffff;
  color: #222222;
}

.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 150rpx;
  box-sizing: border-box;
}



.brand {
  display: flex;
  gap: 8rpx;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 0;
  margin-bottom: 24rpx;
}

.brand-simple {
  display: block;
}

.brand-copy {
  flex: 0 0 178rpx;
  min-width: 0;
  max-width: 178rpx;
  padding-top: 12rpx;
  position: relative;
  z-index: 3;
}

.brand-copy-simple {
  width: 300rpx;
  max-width: 300rpx;
}

.brand-name { 
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #2f7d4a;
}

.brand-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #999999;
}

.pet-monitor-stage {
  width: 100%;
  margin: 0 auto;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.pet-monitor-image {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
  flex: none;
}

.pet-suit-stage {
  position: relative;
  overflow: hidden;
  justify-content: flex-start;
  background: transparent !important;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.pet-suit-character {
  position: absolute;
  bottom: 0;
  transform-origin: center bottom;
  transition: left 0.09s linear, transform 0.09s linear;
  will-change: left, transform;
}

.pet-suit-leg,
.pet-suit-body,
.pet-suit-head {
  position: absolute;
  display: block;
}

.pet-layer {
  opacity: 0;
  pointer-events: none;
}

.pet-layer-visible {
  opacity: 1;
}

.pet-suit-body {
  z-index: 2;
}

.pet-suit-leg {
  z-index: 1;
  transform-origin: center top;
}

.pet-suit-head {
  z-index: 3;
  transform-origin: center center;
}

.pet-hitbox {
  position: absolute;
  z-index: 20;
  left: 10%;
  top: 4%;
  width: 80%;
  height: 92%;
  background: transparent;
}

.pet-state-REACT {
  animation: pet-react 0.22s ease-in-out 5 alternate;
}

.pet-state-SLEEP {
  animation: pet-sleep-breathe 2.4s ease-in-out infinite;
}

@keyframes pet-react {
  from { margin-bottom: 0; }
  to { margin-bottom: 10rpx; }
}

@keyframes pet-sleep-breathe {
  0%, 100% { margin-bottom: 0; }
  50% { margin-bottom: 3rpx; }
}

.pet-monitor-edit {
  width: 96rpx;
  height: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dce8df;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f7d4a;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}

.pet-add {
  flex-shrink: 0;
  width: 214rpx;
  min-height: 180rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #dce7df;
  border-radius: 24rpx;
  background: #f8faf8;
}

.pet-add-plus {
  font-size: 42rpx;
  font-weight: 350;
  line-height: 1;
  color: #2f7d4a;
}

.pet-add-title {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: #577161;
}

.pet-add-tip {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #9aa59d;
}

.hero {
  margin-bottom: 42rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-top-copy {
  flex: 1 1 auto;
  min-width: 0;
  padding-top: 4rpx;
}

.hero-brand-name {
  font-size: 34rpx;
}

.hero-brand-subtitle {
  margin-top: 8rpx;
  margin-bottom: 18rpx;
  font-size: 25rpx;
}

.hero-label {
  display: block;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #2f7d4a;
}

.hero-pet-slot {
  flex: 0 0 326rpx;
  width: 326rpx;
  height: 146rpx;
  overflow: hidden;
}

.home-pets-row {
  width: 100%;
  height: 146rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: end;
  justify-items: center;
  gap: 2rpx;
}

.home-pet-cell {
  width: 104rpx;
  height: 146rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: visible;
}

.home-pet-character {
  position: relative;
  flex: none;
  transform-origin: center bottom;
}

.home-pet-legacy {
  width: 94rpx;
  height: 126rpx;
}

.home-pets-count-1 .home-pet-cell:first-child {
  grid-column: 3;
}

.home-pets-count-2 .home-pet-cell:first-child {
  grid-column: 2;
}

.hero-pet-empty-wrap {
  flex: 0 0 192rpx;
  width: 192rpx;
}

.hero-pet-empty {
  width: 192rpx;
  min-height: 146rpx;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 1.22;
  font-weight: 700;
  color: #202020;
  white-space: nowrap;
}

.hero-date {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #999999;
}

.pet-asset-preload {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 2px;
  height: 2px;
  opacity: 0;
  pointer-events: none;
  overflow: hidden;
}

.pet-asset-preload image {
  width: 2px;
  height: 2px;
}

/* =========================
   进度
   ========================= */

.progress-card {
  padding: 34rpx;

  border-radius: 28rpx;

  background: #f5f8f5;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 650;

  color: #2c3d31;
}

.progress-number {
  font-size: 27rpx;
  font-weight: 700;

  color: #2f7d4a;
}

.progress-track {
  width: 100%;
  height: 12rpx;

  margin-top: 28rpx;

  overflow: hidden;

  border-radius: 999rpx;

  background: #e0e8e2;
}

.progress-0 {
  width: 0%;
}

.progress-1 {
  width: 33.33%;
}

.progress-2 {
  width: 66.67%;
}

.progress-3 {
  width: 100%;
}

.progress-tip {
  display: block;

  margin-top: 18rpx;

  font-size: 24rpx;

  color: #7b867e;
}

.progress-ready {
  color: #2f7d4a;
}

.analyze-button {
  width: 100%;

  margin-top: 28rpx;

  border-radius: 999rpx;

  background: #ffffff;

  color: #2f7d4a;

  font-size: 27rpx;
  font-weight: 600;
}

.analyze-button::after {
  border: 2rpx solid #dce8df;
}


/* =========================
   首页板块
   ========================= */

.section {
  margin-top: 64rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 22rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 650;

  color: #222222;
}

.section-link {
  font-size: 25rpx;

  color: #7a947f;
}


/* =========================
   空状态
   ========================= */

.empty-card {
  padding: 32rpx;

  border-radius: 24rpx;

  background: #f7f7f7;
}

.empty-title {
  display: block;

  font-size: 28rpx;
  font-weight: 600;

  color: #555555;
}

.empty-text {
  display: block;

  margin-top: 10rpx;

  font-size: 24rpx;
  line-height: 1.6;

  color: #aaaaaa;
}


/* =========================
   最近记录
   ========================= */

.record-card {
  padding: 30rpx;

  border: 2rpx solid #eeeeee;
  border-radius: 24rpx;

  background: #ffffff;
}

.record-date {
  display: block;

  font-size: 23rpx;

  color: #999999;
}

.record-summary {
  display: block;

  margin-top: 12rpx;

  font-size: 29rpx;
  line-height: 1.6;

  color: #333333;
}


/* =========================
   最近结果
   ========================= */

.result-card {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 32rpx;

  border-radius: 24rpx;

  background: #f5f8f5;
}

.result-code {
  display: block;

  font-size: 27rpx;
  font-weight: 750;

  color: #2f7d4a;
}

.result-name {
  display: block;

  margin-top: 6rpx;

  font-size: 34rpx;
  font-weight: 650;

  color: #222222;
}

.result-arrow {
  font-size: 48rpx;

  color: #819087;
}


/* =========================
   声明
   ========================= */

.disclaimer {
  display: block;

  margin-top: 80rpx;

  text-align: center;

  font-size: 21rpx;
  line-height: 1.6;

  color: #bbbbbb;
}

/* =========================
   今日运势
   ========================= */

.fortune-section {
  margin-bottom: 60rpx;
}

.fortune-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  margin-bottom: 22rpx;
}

.fortune-eyebrow {
  display: block;

  margin-bottom: 8rpx;

  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;

  color: #2f7d4a;
}

.fortune-title {
  display: block;

  font-size: 38rpx;
  font-weight: 700;

  color: #222222;
}

.fortune-count {
  padding-bottom: 4rpx;

  font-size: 23rpx;

  color: #7a947f;
}

.fortune-card {
  padding: 32rpx;

  border-radius: 28rpx;

  background: #f5f8f5;

  opacity: 1;
  transform: scale(1) translateY(0);
  transition: opacity 200ms ease, transform 200ms ease;
}

.fortune-card-drawing {
  opacity: 0.42;
  transform: scale(0.97) translateY(4rpx);
}

.fortune-image {
  display: block;

  width: 100%;
  height: 350rpx;

  border-radius: 22rpx;

  background: #ffffff;
}

.fortune-result-title {
  display: block;

  margin-top: 28rpx;
  margin-bottom: 22rpx;

  font-size: 34rpx;
  font-weight: 700;

  color: #222222;
}

.fortune-advice {
  display: flex;
  align-items: center;

  min-height: 58rpx;
  margin-top: 12rpx;
}

.fortune-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;

  width: 54rpx;
  height: 42rpx;
  margin-right: 16rpx;

  border-radius: 999rpx;

  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.fortune-label-yi {
  background: #e4efe7;
  color: #2f7d4a;
}

.fortune-label-ji {
  background: #ececea;
  color: #777771;
}

.fortune-advice-text {
  font-size: 27rpx;
  line-height: 1.55;

  color: #424a44;
}

.fortune-comment {
  margin-top: 24rpx;
  padding: 24rpx;

  border-radius: 20rpx;

  background: #ffffff;
}

.fortune-comment-label {
  display: block;

  margin-bottom: 10rpx;

  font-size: 22rpx;
  font-weight: 700;

  color: #6f8976;
}

.fortune-comment-text {
  display: block;

  font-size: 25rpx;
  line-height: 1.7;

  color: #505852;
}

.fortune-actions {
  display: flex;

  margin-top: 28rpx;
  gap: 16rpx;
}

.fortune-action-button {
  flex: 1;

  height: 80rpx;
  margin: 0;
  padding: 0 24rpx;

  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 999rpx;

  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
}

.fortune-action-button::after,
.fortune-shared-button::after {
  border: 0;
}

.fortune-primary-button {
  background: #2f7d4a;
  color: #ffffff;
}

.fortune-share-button {
  border: 2rpx solid #bed1c3;

  background: #ffffff;
  color: #2f7d4a;
}

.fortune-prompt {
  display: block;

  margin-top: 28rpx;

  text-align: center;

  font-size: 27rpx;
  line-height: 1.5;

  color: #6f7b72;
}

.fortune-single-action {
  width: 100%;
  margin-top: 26rpx;
}

.fortune-shared-card {
  margin-bottom: 22rpx;
  padding: 24rpx;

  border: 2rpx solid #e1e9e3;
  border-radius: 24rpx;

  background: #ffffff;
}

.fortune-shared-main {
  display: flex;
  align-items: center;
}

.fortune-shared-image {
  flex-shrink: 0;

  width: 136rpx;
  height: 136rpx;
  margin-right: 22rpx;

  border-radius: 18rpx;

  background: #f5f8f5;
}

.fortune-shared-content {
  min-width: 0;
  flex: 1;
}

.fortune-shared-label {
  display: block;

  font-size: 21rpx;
  font-weight: 700;

  color: #6f8976;
}

.fortune-shared-title {
  display: block;

  margin-top: 6rpx;

  font-size: 29rpx;
  font-weight: 700;

  color: #222222;
}

.fortune-shared-comment {
  display: -webkit-box;

  margin-top: 8rpx;
  overflow: hidden;

  font-size: 22rpx;
  line-height: 1.5;

  color: #858b87;

  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.fortune-shared-button {
  width: 100%;
  height: 64rpx;
  margin-top: 20rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 0;
  border-radius: 999rpx;

  background: #edf4ef;
  color: #2f7d4a;

  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}


@media (max-width: 350px) {
  .brand {
    min-height: 246rpx;
  }

  .pet-add {
    width: 238rpx;
    min-height: 190rpx;
    margin-left: 8rpx;
  }

  .pet-monitor-caption {
    font-size: 18rpx;
  }
}

/* 首页右侧的小屋入口。图片可见下沿与宠物脚底共用同一基线。 */
.pet-home-entry {
  position: absolute;
  right: 0;
  z-index: 30;
  width: 156rpx;
  height: 134rpx;
  text-align: center;
}

.pet-home-entry-image {
  display: block;
  width: 144rpx;
  height: 134rpx;
  margin: 0 auto;
}

.pet-home-entry:active {
  transform: scale(.98);
}

.pet-suit-sleep-mask {
  position: absolute;
  display: block;
  z-index: 4;
  transform-origin: center center;
  pointer-events: none;
}

.pet-asset-preload {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
}

.pet-asset-preload image {
  width: 1px;
  height: 1px;
}

.brand-has-suit-pet .pet-monitor-meta {
  padding-right: 12rpx;
}

/* 编辑入口放到左侧，避免与右侧小屋入口误触。 */
.brand-has-suit-pet .pet-monitor-meta {
  position: relative;
  padding-right: 170rpx;
  align-items: center;
}
.brand-has-suit-pet .pet-monitor-actions {
  order: -1;
}
.brand-has-suit-pet .pet-monitor-edit {
  width: 104rpx;
}
