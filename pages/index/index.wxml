<view class="page">

<!-- 今日状态 -->
<view class="hero">
  <view class="hero-top">
    <view class="hero-top-copy">
      <text class="brand-name hero-brand-name">BUGTI</text>
      <text class="brand-subtitle hero-brand-subtitle">测测你最近是什么 Bug</text>
      <text class="hero-label">TODAY</text>
    </view>

    <view wx:if="{{homePets.length}}" class="hero-pet-slot">
      <view class="home-pets-row home-pets-count-{{homePets.length}}">
        <view
          wx:for="{{homePets}}"
          wx:key="id"
          class="home-pet-cell"
          data-id="{{item.id}}"
          catchtap="onHomePetTap"
          bindlongpress="onHomePetLongPress"
        >
          <view
            wx:if="{{item.isSuit}}"
            class="home-pet-character pet-state-{{item.state}}"
            style="width:{{item.size}}rpx;height:{{item.size}}rpx;"
          >
            <image class="pet-suit-leg pet-layer {{item.showLeftStraight ? 'pet-layer-visible' : ''}}" src="/assets/pet/limbs/pet_leg_straight.png" mode="aspectFit" fade-in="{{false}}" style="{{item.leftLegStraightStyle}}" />
            <image class="pet-suit-leg pet-layer {{item.showRightStraight ? 'pet-layer-visible' : ''}}" src="/assets/pet/limbs/pet_leg_straight.png" mode="aspectFit" fade-in="{{false}}" style="{{item.rightLegStraightStyle}}" />
            <image class="pet-suit-body pet-layer {{!item.showSleep ? 'pet-layer-visible' : ''}}" src="/assets/pet/body/pet_body_default.png" mode="aspectFit" fade-in="{{false}}" style="{{item.bodyStyle}}" />
            <image class="pet-suit-body pet-layer {{item.showSleep ? 'pet-layer-visible' : ''}}" src="/assets/pet/extra/pet_sleep_pose.png" mode="aspectFit" fade-in="{{false}}" style="{{item.sleepPoseStyle}}" />
            <image class="pet-suit-head pet-layer pet-layer-visible" src="{{item.headImage}}" mode="aspectFit" fade-in="{{false}}" style="{{item.headStyle}}" />
            <image wx:if="{{item.showSleep}}" class="pet-suit-sleep-mask" src="/assets/pet/extra/pet_sleep_mask.png" mode="aspectFit" fade-in="{{false}}" style="{{item.sleepMaskStyle}}" />
          </view>
          <image wx:else class="home-pet-legacy" src="{{item.imagePath}}" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view wx:else class="hero-pet-empty-wrap">
      <view class="pet-add hero-pet-empty" bindtap="goToPet">
        <text class="pet-add-plus">＋</text>
        <text class="pet-add-title">添加监工</text>
        <text class="pet-add-tip">让它盯着你记</text>
      </view>
    </view>
  </view>

  <text class="hero-title">今天运行得怎么样？</text>
  <text class="hero-date">{{today}}</text>

  <view wx:if="{{isSuitPet}}" class="pet-asset-preload" aria-hidden="true">
    <image src="/assets/pet/body/pet_body_default.png" />
    <image src="/assets/pet/body/pet_body_react.png" />
    <image src="/assets/pet/body/pet_body_idle_alt.png" />
    <image src="/assets/pet/extra/pet_sleep_pose.png" />
    <image src="/assets/pet/extra/pet_sleep_mask.png" />
  </view>
</view>

<!-- 今日运势 -->
<view class="fortune-section">

  <view class="fortune-header">
    <view>
      <text class="fortune-eyebrow">TODAY'S LUCK</text>
      <text class="fortune-title">今日一抽</text>
    </view>

    <text
      wx:if="{{fortuneDrawCount > 0}}"
      class="fortune-count"
    >
      第 {{fortuneDrawCount}} 抽
    </text>
  </view>

  <view
    wx:if="{{sharedFortunePreview}}"
    class="fortune-shared-card"
  >
    <view class="fortune-shared-main">
      <image
        class="fortune-shared-image"
        src="{{sharedFortunePreview.image}}"
        mode="aspectFit"
      />

      <view class="fortune-shared-content">
        <text class="fortune-shared-label">
          朋友刚抽到
        </text>

        <text class="fortune-shared-title">
          {{sharedFortunePreview.title}}
        </text>

        <text class="fortune-shared-comment">
          {{sharedFortunePreview.comment}}
        </text>
      </view>
    </view>

    <button
      class="fortune-shared-button"
      bindtap="drawFortune"
    >
      我也抽一个
    </button>
  </view>

  <view
    class="fortune-card {{fortuneAnimating ? 'fortune-card-drawing' : ''}}"
  >
    <image
      class="fortune-image"
      src="{{fortuneImage}}"
      mode="aspectFit"
    />

    <block wx:if="{{fortune}}">
      <text class="fortune-result-title">
        今日：{{fortune.title}}
      </text>

      <view class="fortune-advice">
        <text class="fortune-label fortune-label-yi">宜</text>
        <text class="fortune-advice-text">{{fortune.yi}}</text>
      </view>

      <view class="fortune-advice">
        <text class="fortune-label fortune-label-ji">忌</text>
        <text class="fortune-advice-text">{{fortune.ji}}</text>
      </view>

      <view class="fortune-comment">
        <text class="fortune-comment-label">系统评价</text>
        <text class="fortune-comment-text">{{fortune.comment}}</text>
      </view>

      <view class="fortune-actions">
        <button
          class="fortune-action-button fortune-primary-button"
          bindtap="drawFortune"
        >
          再抽一次
        </button>

        <button
          class="fortune-action-button fortune-share-button"
          open-type="share"
          data-share-kind="fortune"
        >
          分享这张
        </button>
      </view>
    </block>

    <block wx:else>
      <text class="fortune-prompt">
        今天系统想跟你说什么？
      </text>

      <button
        class="fortune-action-button fortune-primary-button fortune-single-action"
        bindtap="drawFortune"
      >
        抽一下
      </button>
    </block>
  </view>

</view>



<bugti-nav current="home" />


</view>
