.page {
  min-height: 100vh;
  padding: 48rpx 36rpx 90rpx;
  box-sizing: border-box;
  background: #ffffff;
}

/* 顶部 */
.header {
  margin-bottom: 56rpx;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #2f7d4a;
}

.title {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #222222;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #999999;
}

/* 月份选择 */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.month-title {
  font-size: 34rpx;
  font-weight: 650;
  color: #222222;
}

.month-arrow {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f7f5;
  font-size: 48rpx;
  color: #4f6755;
}

/* 星期 */
.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.week-name {
  text-align: center;
  font-size: 23rpx;
  line-height: 36rpx;
  color: #aaaaaa;
}

/* 日历 */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  column-gap: 2rpx;
  row-gap: 6rpx;
}

.day-cell {
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.day-card {
  width: 82rpx;
  height: 100rpx;
  padding: 8rpx 0 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: transparent;
}

.day-number {
  display: block;
  min-width: 32rpx;
  height: 28rpx;
  margin: 0;
  padding: 0;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 28rpx;
  text-align: center;
  color: #777777;
}

.day-mood-slot {
  width: 44rpx;
  height: 38rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-mood {
  display: block;
  margin: 0;
  padding: 0;
  font-size: 27rpx;
  line-height: 1;
  text-align: center;
}

/* 有记录 */
.day-recorded {
  background: #f1f6f2;
}

.day-recorded .day-number {
  color: #2f7d4a;
  font-weight: 600;
}

/* 今天 */
.day-today {
  border: 2rpx solid #a9cbb4;
}

/* 未来 */
.day-future {
  opacity: 0.30;
}

/* 月初空位 */
.day-empty {
  visibility: hidden;
}

/* 本月统计：恢复为原先更自然的基线排版 */
.month-summary {
  display: flex;
  align-items: baseline;
  margin-top: 42rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #f5f8f5;
}

.summary-number {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  color: #2f7d4a;
}

.summary-text {
  margin-left: 12rpx;
  font-size: 27rpx;
  line-height: 1;
  color: #555555;
}

.footer-tip {
  display: block;
  margin-top: 22rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #aaaaaa;
}
