page { background: #fff; }
.history-page { padding: 0 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.history-toolbar { padding: 26rpx 0; display: flex; align-items: center; justify-content: space-between; }
.history-title { display: block; font-size: 33rpx; font-weight: 600; }
.history-subtitle { display: block; font-size: 23rpx; margin-top: 10rpx; color: #939ca5; }
.manage-button { padding: 12rpx 18rpx; margin: 0; color: #1980c8; background: transparent; font-size: 27rpx; line-height: 1.5; }
.manage-bar { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; color: #959da5; border-top: 1rpx solid #f0f2f4; }
.clear-button { margin: 0; padding: 20rpx 0 20rpx 20rpx; color: #a2574e; font-size: 25rpx; background: transparent; line-height: 1.5; }
.date-label { display: block; padding: 30rpx 0 20rpx; font-size: 28rpx; font-weight: 600; }
.history-row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f1f3f5; }
.history-cover, .history-text-cover { width: 160rpx; height: 180rpx; border-radius: 14rpx; flex-shrink: 0; background: #eaf3fa; }
.history-text-cover { display: flex; align-items: center; justify-content: center; color: #1980c8; font-size: 35rpx; font-weight: 600; }
.history-copy { flex: 1; min-width: 0; padding: 0 24rpx; }
.history-note-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 29rpx; line-height: 1.5; font-weight: 500; word-break: break-all; }
.history-author { display: block; margin-top: 15rpx; font-size: 23rpx; color: #919aa3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-meta { display: flex; margin-top: 13rpx; color: #8b959e; font-size: 22rpx; }
.history-meta text + text { margin-left: 24rpx; }
.remove-history { padding: 24rpx 0 24rpx 14rpx; }
.history-empty-title { margin-top: 30rpx; }
