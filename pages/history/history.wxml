<view class="history-page"><view class="history-toolbar"><view><text class="history-title">看过的，都是相遇</text><text class="history-subtitle">浏览记录仅自己可见</text></view><button class="manage-button" bindtap="onManage">{{managing ? '完成' : '管理'}}</button></view>
  <view wx:if="{{managing}}" class="manage-bar"><text>可移除单条记录</text><button class="clear-button" loading="{{clearing}}" disabled="{{clearing}}" bindtap="onClear">清空全部</button></view>
  <view wx:if="{{initialLoading}}" class="load-more">正在加载…</view>
  <view wx:elif="{{errorText && !posts.length}}" class="empty-state"><text class="empty-desc">{{errorText}}</text><button class="retry-button" bindtap="onRetry">重新加载</button></view>
  <view wx:elif="{{!posts.length}}" class="empty-state"><ouc-icon name="history" active size="80" /><text class="empty-title history-empty-title">还没有浏览记录</text><text class="empty-desc">打开一篇笔记，下次就能在这里找到。</text></view>
  <view wx:for="{{groups}}" wx:key="label" wx:for-item="group" class="history-group"><text class="date-label">{{group.label}}</text><view wx:for="{{group.items}}" wx:key="_id" class="history-row" data-id="{{item._id}}" bindtap="onOpen" hover-class="tap-feedback"><image wx:if="{{item.coverFileID}}" class="history-cover" src="{{item.coverFileID}}" mode="aspectFill" lazy-load /><view wx:else class="history-text-cover">{{item.categoryLabel}}</view><view class="history-copy"><text class="history-note-title">{{item.title}}</text><text class="history-author">{{item.author.nickname}}</text><view class="history-meta"><text>{{item.categoryLabel}}</text><text>{{item.likeCount}} 赞</text></view></view><view wx:if="{{managing}}" class="remove-history" data-id="{{item._id}}" catchtap="onRemove" aria-label="移除这条记录"><ouc-icon name="close" size="34" /></view><ouc-icon wx:else name="chevron" size="27" /></view></view>
  <view wx:if="{{errorText && posts.length}}" class="load-more" bindtap="onRetry">{{errorText}} · 点击重试</view><view wx:elif="{{loading && !initialLoading}}" class="load-more">正在加载…</view><view wx:elif="{{!loading && hasMore}}" class="load-more" bindtap="onReachBottom">加载更多记录</view><view wx:elif="{{!hasMore && posts.length}}" class="load-more">— 已经到底了 —</view>
</view>
