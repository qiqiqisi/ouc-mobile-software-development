page {
  background: #f6f7f3;
  color: #222222;
}

.page {
  min-height: 100vh;
  padding: 20rpx 22rpx 132rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.room-topbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 4rpx 4rpx 18rpx;
}

.room-eyebrow,
.room-title {
  display: block;
}

.room-eyebrow {
  color: #2f7d4a;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.room-title {
  margin-top: 4rpx;
  color: #202020;
  font-size: 34rpx;
  font-weight: 800;
}


.room-topbar-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pet-edit-pill,
.focus-pill {
  min-width: 102rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
  border: 1rpx solid #dbe7dd;
  border-radius: 999rpx;
  background: rgba(255,255,255,.92);
  text-align: center;
}

.pet-edit-code,
.pet-edit-label {
  display: block;
  line-height: 1;
}

.pet-edit-code {
  color: #6f8676;
  font-size: 12rpx;
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.pet-edit-label {
  margin-top: 5rpx;
  color: #3f684b;
  font-size: 16rpx;
  font-weight: 700;
}

.pet-edit-pill:active,
.focus-pill:active {
  opacity: .72;
}
.plan-summary-pill {
  min-width: 112rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid #dde7df;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .92);
  text-align: center;
}

.plan-summary-label,
.plan-summary-number {
  display: block;
}

.plan-summary-label {
  color: #78907f;
  font-size: 15rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.plan-summary-number {
  margin-top: 2rpx;
  color: #2f7d4a;
  font-size: 22rpx;
  font-weight: 800;
}

.room-stage {
  position: relative;
  width: 100%;
  flex: 1 1 auto;
  overflow: hidden;
  border: 1rpx solid rgba(52, 72, 58, .08);
  border-radius: 30rpx;
  background: #f4f5ef;
  box-shadow: 0 12rpx 32rpx rgba(56, 66, 58, .07);
}

.room-background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.room-status-board,
.room-desk,
.room-toy,
.room-pet,
.room-empty-pet {
  position: absolute;
  box-sizing: border-box;
}

.room-asset-image {
  display: block;
  width: 100%;
  height: auto;
}

.room-status-board {
  transform-origin: center center;
}

.room-status-board:active,
.room-desk:active {
  transform: scale(.985);
}

.board-copy {
  position: absolute;
  left: 14%;
  right: 9%;
  top: 30%;
  bottom: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  pointer-events: none;
}

.board-code {
  display: block;
  overflow: hidden;
  color: #f7f3df;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-shadow: 0 1rpx 2rpx rgba(20,55,42,.30);
}

.board-plan {
  display: block;
  margin-top: 4rpx;
  color: rgba(247,243,223,.90);
  font-size: 13rpx;
  font-weight: 700;
}

.room-desk {
  transform-origin: center bottom;
}


.room-pet {
  transform-origin: center bottom;
  will-change: left, top, transform;
  transition: left .08s linear, top .08s linear, transform .08s linear;
}

.room-pet-visual {
  position: absolute;
  inset: 0;
  transform-origin: center bottom;
}

.pet-layer,
.pet-body,
.pet-head,
.pet-sleep-mask {
  position: absolute;
  display: block;
  pointer-events: none;
}

.pet-layer {
  opacity: 0;
}

.layer-visible {
  opacity: 1;
}

.pet-leg {
  z-index: 1;
  transform-origin: center top;
}

.pet-body {
  z-index: 2;
}

.pet-head {
  z-index: 3;
  transform-origin: center center;
}

.pet-sleep-mask {
  z-index: 4;
  transform-origin: center center;
}

.pet-state-REACT,
.pet-state-CATCH {
  animation: room-pet-react .2s ease-in-out 4 alternate;
}

.pet-state-SLEEP {
  animation: room-pet-breathe 2.5s ease-in-out infinite;
}

@keyframes room-pet-react {
  from { margin-top: 0; }
  to { margin-top: -7rpx; }
}

@keyframes room-pet-breathe {
  0%, 100% { margin-top: 0; }
  50% { margin-top: 2rpx; }
}

.pet-bubble {
  position: absolute;
  left: 50%;
  bottom: 95%;
  min-width: 150rpx;
  max-width: 290rpx;
  padding: 10rpx 14rpx;
  transform: translateX(-50%);
  border: 1rpx solid #dbe7dd;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 6rpx 16rpx rgba(40, 61, 46, .08);
  color: #53695a;
  font-size: 17rpx;
  line-height: 1.35;
  text-align: center;
  white-space: nowrap;
  z-index: 20;
}

.room-empty-pet {
  left: 31%;
  right: 9%;
  top: 57%;
  z-index: 170;
  padding: 24rpx;
  border: 1rpx solid rgba(67, 104, 77, .1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .88);
  text-align: center;
}

.empty-pet-title,
.empty-pet-copy {
  display: block;
}

.empty-pet-title {
  color: #2f5e3e;
  font-size: 24rpx;
  font-weight: 800;
}

.empty-pet-copy {
  margin-top: 7rpx;
  color: #829187;
  font-size: 18rpx;
  line-height: 1.5;
}

.empty-pet-button {
  margin: 18rpx auto 0;
  width: 180rpx;
  padding: 11rpx 0;
  border-radius: 999rpx;
  background: #2f8650;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 700;
}

.room-toy {
  z-index: 480;
  touch-action: none;
}

.room-toy:active {
  transform: scale(1.03);
}

.room-toy .room-asset-image {
  width: 100%;
  height: 100%;
}

.sheet-backdrop {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(27, 34, 29, .22);
}

.bottom-sheet {
  width: 100%;
  max-height: 72vh;
  overflow-y: auto;
  padding: 14rpx 26rpx 34rpx;
  box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.sheet-handle {
  width: 88rpx;
  height: 8rpx;
  margin: 2rpx auto 20rpx;
  border-radius: 999rpx;
  background: #dbe6dd;
}

.sheet-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-eyebrow,
.sheet-title,
.sheet-count,
.status-code {
  display: block;
}

.sheet-eyebrow {
  color: #7a8e80;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.sheet-title {
  margin-top: 4rpx;
  color: #202020;
  font-size: 30rpx;
  font-weight: 800;
}

.sheet-count,
.status-code {
  color: #2f7d4a;
  font-size: 24rpx;
  font-weight: 800;
}

.plan-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.plan-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 76rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f4f7f4;
  font-size: 24rpx;
}

.plan-add-button {
  flex: 0 0 auto;
  padding: 0 26rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #2f8650;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.plan-list {
  margin-top: 20rpx;
}

.plan-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 2rpx;
  border-bottom: 1rpx solid #eef2ef;
}

.plan-main {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.plan-check {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d5e3d9;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
}

.plan-check-done {
  border-color: #2f8650;
  background: #2f8650;
}

.plan-text {
  flex: 1 1 auto;
  min-width: 0;
  color: #26312a;
  font-size: 24rpx;
  line-height: 1.45;
}

.plan-text-done {
  color: #9ba8a0;
  text-decoration: line-through;
}

.plan-remove {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #97a49c;
  font-size: 34rpx;
  line-height: 1;
}

.plan-empty {
  margin-top: 26rpx;
  padding: 30rpx 24rpx;
  border-radius: 24rpx;
  background: #f6f8f6;
  text-align: center;
}

.plan-empty-title {
  display: block;
  color: #50665a;
  font-size: 24rpx;
  font-weight: 700;
}

.plan-empty-copy {
  display: block;
  margin-top: 10rpx;
  color: #8a988f;
  font-size: 20rpx;
  line-height: 1.5;
}

.status-sheet {
  padding-bottom: 30rpx;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.status-cell,
.status-block {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f6f8f6;
}

.status-key {
  display: block;
  color: #7d8b83;
  font-size: 18rpx;
  font-weight: 700;
}

.status-value,
.status-block-value,
.status-personality {
  display: block;
  margin-top: 8rpx;
  color: #26312a;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
}

.status-block {
  margin-top: 14rpx;
}

.status-personality {
  color: #2f7d4a;
}

.sheet-close {
  margin-top: 26rpx;
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #edf4ef;
  color: #43634d;
  font-size: 24rpx;
  font-weight: 700;
}

.asset-preload {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 2px;
  height: 2px;
  opacity: 0;
  pointer-events: none;
  overflow: hidden;
}

.asset-preload image {
  width: 2px;
  height: 2px;
}

/* 给固定底部导航留安全区，房间舞台仍占据其余可用高度。 */
.page {
  padding-bottom: calc(142rpx + env(safe-area-inset-bottom));
}


.manager-count {
  color: #2f7d4a;
  font-size: 22rpx;
  font-weight: 800;
}

.manager-list {
  margin-top: 22rpx;
}

.manager-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #e5ece7;
  border-radius: 22rpx;
  background: #f8faf8;
}

.manager-item-primary {
  border-color: #b9d7c2;
  background: #f1f7f2;
}

.manager-avatar {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
}

.manager-avatar image {
  width: 100%;
  height: 100%;
}

.manager-info {
  flex: 1 1 auto;
  min-width: 0;
}

.manager-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.manager-name {
  color: #26312a;
  font-size: 23rpx;
  font-weight: 800;
}

.manager-primary-badge {
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  background: #dcecdf;
  color: #2f7d4a;
  font-size: 14rpx;
  font-weight: 700;
}

.manager-desc {
  display: block;
  margin-top: 6rpx;
  color: #8b978f;
  font-size: 17rpx;
  line-height: 1.4;
}

.manager-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.manager-action {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf3ec;
  color: #3d6d4a;
  font-size: 16rpx;
  font-weight: 700;
}

.manager-action-edit {
  background: #ffffff;
  border: 1rpx solid #dfe7e1;
  color: #67756c;
}

.manager-add {
  margin-top: 18rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #bfd6c5;
  border-radius: 20rpx;
  color: #2f7d4a;
  font-size: 21rpx;
  font-weight: 700;
}

.manager-limit {
  display: block;
  margin-top: 16rpx;
  color: #8c9890;
  font-size: 18rpx;
  line-height: 1.45;
  text-align: center;
}

/* 监工碰面特效：随机大小的爱心/星星向上飘散。 */
.pet-collision-fx-layer {
  position: absolute;
  inset: 0;
  z-index: 900;
  pointer-events: none;
  overflow: hidden;
}

.pet-collision-fx {
  position: absolute;
  display: block;
  line-height: 1;
  transform: translate(-50%, -50%) scale(.7);
  opacity: 0;
  animation: pet-collision-pop 1.05s cubic-bezier(.18,.74,.27,1) forwards;
  filter: drop-shadow(0 2rpx 4rpx rgba(60, 65, 58, .12));
}

@keyframes pet-collision-pop {
  0% {
    opacity: 0;
    transform: translate(-50%, 4px) scale(.55) rotate(-8deg);
  }
  18% {
    opacity: 1;
    transform: translate(-50%, -6px) scale(1.05) rotate(5deg);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -42px) scale(.88) rotate(14deg);
  }
}

.focus-pill {
  min-width: 100rpx;
  padding: 10rpx 13rpx;
  box-sizing: border-box;
  border: 1rpx solid #cfe2d4;
  border-radius: 999rpx;
  background: #edf6ef;
  text-align: center;
}
.focus-pill .pet-edit-code { color:#2f8650; }
.focus-pill .pet-edit-label { color:#2f6d43; }
.plan-copy { flex:1 1 auto; min-width:0; }
.plan-focus-meta { display:block; margin-top:4rpx; color:#8a978e; font-size:16rpx; }
.plan-focus-button { flex:0 0 auto; padding:8rpx 13rpx; border-radius:999rpx; background:#edf6ef; color:#2f8650; font-size:17rpx; font-weight:700; }
