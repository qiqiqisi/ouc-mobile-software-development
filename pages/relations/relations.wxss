page { background: #fff; }
.relations-page { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.section-tabs { position: sticky; top: 0; z-index: 10; }
.person-row { display: flex; align-items: center; padding: 28rpx 32rpx; }
.person-main { display: flex; align-items: center; flex: 1; min-width: 0; margin-right: 20rpx; }
.person-avatar { width: 92rpx; height: 92rpx; flex-shrink: 0; border-radius: 50%; background: #f5f7f9; }
.person-copy { min-width: 0; margin-left: 22rpx; }
.person-name { display: block; font-size: 29rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.person-sub { display: block; margin-top: 10rpx; color: #929ca6; font-size: 23rpx; }
.relation-empty-title { margin-top: 30rpx; }
