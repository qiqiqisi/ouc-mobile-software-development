page {
  background: #ffffff;
  color: #222222;
}

.page {
  min-height: 100vh;
  padding: 42rpx 40rpx 90rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 34rpx;
}

.eyebrow,
.step-code {
  display: block;
  font-size: 21rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
  color: #2f7d4a;
}

.title {
  display: block;
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 750;
  line-height: 1.25;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #8b948d;
}

.intro-panel,
.existing-panel,
.name-panel,
.paint-panel,
.preview-panel {
  width: 100%;
  box-sizing: border-box;
}

.intro-panel {
  padding: 54rpx 34rpx 38rpx;
  border-radius: 28rpx;
  background: #f5f8f5;
  text-align: center;
}

.intro-mark {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d8e5db;
  border-radius: 28rpx;
  background: #ffffff;
  color: #2f7d4a;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.intro-title {
  display: block;
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.intro-text {
  display: block;
  margin: 14rpx auto 34rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #879088;
}

.primary-button,
.secondary-button,
.danger-button,
.mode-button {
  margin: 0;
  min-height: 82rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1;
}

.primary-button::after,
.secondary-button::after,
.danger-button::after,
.mode-button::after {
  border: 0;
}

.primary-button {
  background: #2f7d4a;
  color: #ffffff;
}

.primary-button[disabled] {
  background: #b8c9bd;
  color: #ffffff;
}

.secondary-button {
  border: 2rpx solid #dfe7e1;
  background: #ffffff;
  color: #496453;
}

.danger-button {
  margin-top: 22rpx;
  background: #ffffff;
  color: #a24c40;
  border: 2rpx solid #ead9d5;
}

.step-row,
.scale-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step-number {
  font-size: 21rpx;
  color: #9aa39c;
}

.editor-title {
  display: block;
  margin-top: 13rpx;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 720;
}

.editor-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #879088;
}

.canvas-shell {
  width: 100%;
  height: 610rpx;
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 26rpx;
  background: #f2f6f3;
  border: 2rpx solid #e4ebe6;
}

.pet-paint-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.paint-tools {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f7faf7;
}

.mode-row {
  display: flex;
  gap: 14rpx;
}

.mode-button {
  flex: 1;
  min-height: 72rpx;
  border: 2rpx solid #dce6df;
  background: #ffffff;
  color: #66756a;
  font-size: 23rpx;
}

.mode-button-active {
  border-color: #2f7d4a;
  background: #edf5ef;
  color: #2f7d4a;
}

.brush-row,
.scale-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
}

.brush-label {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 23rpx;
  color: #657169;
}

.brush-slider,
.scale-slider {
  flex: 1;
  margin: 0 10rpx;
}

.brush-size-dot {
  flex-shrink: 0;
  display: block;
  border-radius: 999rpx;
  background: #2f7d4a;
}

.brush-size-small {
  width: 12rpx;
  height: 12rpx;
}

.brush-size-large {
  width: 30rpx;
  height: 30rpx;
}

.bottom-actions,
.existing-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.bottom-actions > button,
.existing-actions > button {
  flex: 1;
}

.three-actions {
  gap: 12rpx;
}

.small-action {
  min-width: 0;
  padding: 0 12rpx;
  font-size: 23rpx;
}

.preview-checker {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f6f8f6;
  background-image:
    linear-gradient(45deg, #e7ece8 25%, transparent 25%),
    linear-gradient(-45deg, #e7ece8 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #e7ece8 75%),
    linear-gradient(-45deg, transparent 75%, #e7ece8 75%);
  background-size: 28rpx 28rpx;
  background-position:
    0 0,
    0 14rpx,
    14rpx -14rpx,
    -14rpx 0;
}

.final-preview {
  height: 520rpx;
  margin-top: 24rpx;
  margin-bottom: 28rpx;
  border-radius: 28rpx;
}

.final-preview-image,
.existing-image,
.name-preview-image {
  width: 220rpx;
  height: 200rpx;
  flex: none;
  transition: transform 0.12s ease;
}

.field-label {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 650;
  color: #3a453d;
}

.compact-label {
  margin: 0;
}

.name-input {
  width: 100%;
  height: 86rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border: 2rpx solid #dde6df;
  border-radius: 22rpx;
  background: #ffffff;
  font-size: 29rpx;
  color: #222222;
}

.field-help {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #a0a6a1;
}

.field-help-error {
  color: #b4513f;
}

.scale-block {
  margin-top: 28rpx;
  padding: 22rpx 22rpx 10rpx;
  border-radius: 22rpx;
  background: #f7faf7;
}

.preview-scale-block {
  margin-top: 0;
  margin-bottom: 30rpx;
}

.scale-value,
.scale-label {
  font-size: 21rpx;
  color: #748078;
}

.existing-preview {
  width: 100%;
  height: 480rpx;
  border-radius: 28rpx;
}

.existing-name {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 38rpx;
  font-weight: 720;
}

.existing-caption {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  font-size: 23rpx;
  color: #89938b;
}

.existing-home-button {
  margin-top: 22rpx;
}

.name-preview {
  width: 100%;
  height: 400rpx;
  margin-bottom: 30rpx;
  border-radius: 28rpx;
}

.aux-canvas {
  position: fixed;
  left: -20px;
  top: -20px;
  width: 2px;
  height: 2px;
  opacity: 0;
  pointer-events: none;
}

@media (max-width: 350px) {
  .page {
    padding-left: 30rpx;
    padding-right: 30rpx;
  }

  .canvas-shell {
    height: 570rpx;
  }

  .small-action {
    font-size: 21rpx;
  }
}
