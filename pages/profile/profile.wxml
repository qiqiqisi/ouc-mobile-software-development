<view class="page profile-page">
  <view class="profile-header">
    <view style="height: {{statusBarHeight}}px;"></view><view class="profile-nav" style="height: {{navHeight}}px;"><text>我的海大圈</text></view>
    <view class="profile-identity"><image class="profile-avatar" src="{{user.avatarFileID || '/assets/ouc-logo.png'}}" mode="aspectFill" /><view class="identity-copy"><text class="profile-name">{{user.nickname || '海大同学'}}</text><text class="profile-id">OUC · 中国海洋大学</text></view></view>
    <text class="profile-bio">在海大，收藏日常的每一份热爱。</text>
    <view class="profile-bottom"><view class="stats"><view class="stat" data-type="following" bindtap="onRelations"><text class="stat-value">{{user.followingCount || 0}}</text><text class="stat-label">关注</text></view><view class="stat" data-type="followers" bindtap="onRelations"><text class="stat-value">{{user.followerCount || 0}}</text><text class="stat-label">粉丝</text></view><view class="stat" bindtap="onAppreciation"><text class="stat-value">{{(user.receivedLikes || 0) + (user.receivedFavorites || 0)}}</text><text class="stat-label">获赞与收藏</text></view></view><button class="edit-profile" bindtap="onEditProfile">编辑资料</button></view>
  </view>
  <view wx:if="{{profileError}}" class="profile-error" bindtap="loadProfile">{{profileError}} · 点击重试</view>
  <view class="history-entry" bindtap="onHistory" hover-class="tap-feedback"><view class="history-icon"><ouc-icon name="history" active size="36" /></view><view class="history-copy"><text>浏览记录</text><text class="history-hint">找回看过的校园日常</text></view><ouc-icon name="chevron" size="30" /></view>
  <view class="section-tabs"><view wx:for="{{tabs}}" wx:key="key" class="section-tab {{tab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTabTap">{{item.label}}</view></view>
  <view wx:if="{{tab === 'posts'}}" class="filter-row"><text class="filter-item {{filter === '' ? 'selected' : ''}}" data-key="" bindtap="onFilterTap">全部 {{user.postCount || 0}}</text><text class="filter-item {{filter === 'open' ? 'selected' : ''}}" data-key="open" bindtap="onFilterTap">进行中</text><text class="filter-item {{filter === 'resolved' ? 'selected' : ''}}" data-key="resolved" bindtap="onFilterTap">已解决 / 找到</text></view>
  <view wx:if="{{initialLoading}}" class="load-more">正在加载…</view>
  <view wx:elif="{{errorText && !posts.length}}" class="empty-state"><text class="empty-title">暂时没有加载成功</text><text class="empty-desc">{{errorText}}</text><button class="retry-button" bindtap="onRetry">重新加载</button></view>
  <view wx:elif="{{!posts.length}}" class="empty-state"><image class="empty-logo" src="/assets/ouc-logo.png" mode="aspectFit" /><text class="empty-title">{{tab === 'favorite' ? '把喜欢的日常收藏起来' : tab === 'like' ? '让喜欢留下痕迹' : '还没有对应的笔记'}}</text><text class="empty-desc">{{tab === 'posts' ? '分享校园里的第一份日常吧。' : '你标记的笔记会出现在这里，仅自己可见。'}}</text></view>
  <view wx:else class="feed"><view class="column"><post-card wx:for="{{posts}}" wx:key="_id" wx:if="{{index % 2 === 0}}" post="{{item}}" bind:tapcard="onPostTap" bind:tapauthor="onAuthorTap" bind:like="onLikeTap" /></view><view class="column"><post-card wx:for="{{posts}}" wx:key="_id" wx:if="{{index % 2 === 1}}" post="{{item}}" bind:tapcard="onPostTap" bind:tapauthor="onAuthorTap" bind:like="onLikeTap" /></view></view>
  <view wx:if="{{errorText && posts.length}}" class="load-more" bindtap="onRetry">{{errorText}} · 点击重试</view><view wx:elif="{{loading && !initialLoading}}" class="load-more">正在加载…</view><view wx:elif="{{!loading && hasMore}}" class="load-more" bindtap="onReachBottom">加载更多</view><view wx:elif="{{!hasMore && posts.length}}" class="load-more">— 已经到底了 —</view>
</view>
