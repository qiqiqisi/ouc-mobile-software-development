page {
  min-height: 100%;
  background: #f7f8fa;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, image, input, textarea, button {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

button { font-family: inherit; }
button[disabled] { opacity: .55; }
.tap-feedback { opacity: .65; }
.feed { display: flex; align-items: flex-start; padding: 16rpx 16rpx 0; }
.column { flex: 1; min-width: 0; width: calc((100% - 14rpx) / 2); }
.column + .column { margin-left: 14rpx; }
.column post-card { display: block; margin-bottom: 16rpx; }
.load-more { padding: 32rpx; text-align: center; color: #858c93; font-size: 24rpx; }
.retry-button { width: 220rpx; margin-top: 24rpx; border-radius: 40rpx; font-size: 26rpx; color: #1980c8; background: #eef7fd; }
.follow-button { margin: 0; padding: 0 28rpx; min-width: 138rpx; height: 62rpx; line-height: 58rpx; border: 2rpx solid #1980c8; border-radius: 40rpx; background: #fff; color: #1980c8; font-size: 27rpx; font-weight: 500; flex-shrink: 0; }
.follow-button.followed { border-color: #dce1e5; color: #858c93; background: #fafbfc; }
.section-tabs { display: flex; justify-content: center; border-bottom: 1rpx solid #edf0f2; background: #fff; }
.section-tab { position: relative; padding: 26rpx 38rpx; color: #7d848b; font-size: 29rpx; }
.section-tab.active { color: #20252b; font-weight: 600; }
.section-tab.active::after { content: ''; position: absolute; bottom: 9rpx; left: 50%; width: 36rpx; height: 5rpx; background: #1980c8; border-radius: 5rpx; transform: translateX(-50%); }

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

.empty-state {
  padding: 120rpx 48rpx;
  text-align: center;
  color: #8a9099;
}

.empty-logo {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 24rpx;
  opacity: 0.38;
}

.empty-title {
  display: block;
  color: #4b535d;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-desc {
  display: block;
  font-size: 25rpx;
  line-height: 1.7;
}

.primary-button {
  border: 0;
  border-radius: 999rpx;
  background: #1980c8;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}

.ghost-button {
  border: 2rpx solid #dfe5ec;
  border-radius: 999rpx;
  background: #fff;
  color: #2f3740;
  font-size: 28rpx;
}
