:host { display: block; width: 100%; }
.card { width: 100%; overflow: hidden; border-radius: 15rpx; background: #fff; }
.card-pressed { opacity: .88; }
.cover { position: relative; width: 100%; background: #edf2f7; overflow: hidden; min-height: 160rpx; }
.cover-image { display: block; width: 100%; height: auto; }
.text-cover { padding: 32rpx 25rpx; min-height: 330rpx; display: flex; flex-direction: column; justify-content: space-between; }
.tone-orange { background: #f5eee2; color: #846441; }
.tone-blue { background: #e5eff8; color: #265d89; }
.tone-red { background: #f4e9e5; color: #91614c; }
.tone-cyan { background: #e3f1f0; color: #2e756f; }
.tone-gray { background: #edf0f4; color: #626a74; }
.text-cover-type { font-size: 21rpx; opacity: .8; }
.text-cover-title { padding: 24rpx 0; font-size: 35rpx; line-height: 1.5; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.text-cover-sign { font-size: 17rpx; letter-spacing: 3rpx; opacity: .6; }
.image-badge { position: absolute; top: 14rpx; right: 14rpx; background: rgba(255,255,255,.86); border-radius: 50%; padding: 8rpx; display: flex; }
.card-body { padding: 17rpx 16rpx 9rpx; }
.card-title { color: #262b31; font-size: 28rpx; line-height: 1.5; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.card-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 9rpx; min-height: 55rpx; }
.author { display: flex; flex: 1; min-width: 0; align-items: center; }
.avatar { width: 34rpx; height: 34rpx; border-radius: 50%; flex-shrink: 0; background: #f5f7f9; }
.author-name { margin-left: 8rpx; color: #777e86; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-like { display: flex; align-items: center; flex-shrink: 0; min-height: 58rpx; max-width: 115rpx; padding: 6rpx 0 6rpx 12rpx; color: #6e757d; font-size: 23rpx; }
.card-like text { margin-left: 5rpx; overflow: hidden; text-overflow: ellipsis; }
.card-like.liked { color: #1980c8; }
.time { font-size: 22rpx; color: #959ba2; }
