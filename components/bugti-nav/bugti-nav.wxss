
:host {
  display: block;
}

.nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 980;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 0 18rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 1fr 1fr 112rpx 1fr 1fr;
  align-items: center;
  border-top: 1rpx solid rgba(47, 88, 60, .10);
  border-radius: 24rpx 24rpx 0 0;
  background: rgba(255,255,255,.98);
  box-shadow: 0 -4rpx 18rpx rgba(32, 50, 38, .08);
  backdrop-filter: blur(16rpx);
}

.nav-item {
  min-width: 0;
  height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9aa39d;
}

.nav-code,
.nav-label {
  display: block;
  line-height: 1;
}

.nav-code {
  font-size: 14rpx;
  font-weight: 800;
  letter-spacing: 1.4rpx;
}

.nav-label {
  margin-top: 9rpx;
  font-size: 19rpx;
  font-weight: 650;
}

.nav-item-active {
  color: #2f8650;
}

.nav-create {
  width: 86rpx;
  height: 86rpx;
  margin: -30rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #ffffff;
  border-radius: 999rpx;
  background: #2f8650;
  box-shadow: 0 9rpx 22rpx rgba(47, 134, 80, .20);
}

.nav-plus {
  margin-top: -4rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.nav-create:active,
.nav-item:active {
  opacity: .72;
}
